{
  "api_key": "replace-with-capability-api-key",
  "callback_secret": "replace-with-callback-hmac-secret",
  "endpoints": {
    "image_audit": "https://capability.example.com/v1/image/audit",
    "prompt_shield": "https://capability.example.com/v1/prompt/shield"
  },
  "image_gateway": {
    "model": "ad.genai.seedream_4_5",
    "task_queue": "jichuang_agent",
    "width": 1440,
    "height": 2560
  },
  "clipmix": {
    "model": "replace-with-clipmix-planning-model"
  },
  "character_image": {
    "gen_url": "https://modelhub.example.com/generate?key={{api_key}}",
    "edit_url": "https://modelhub.example.com/edit?key={{api_key}}",
    "api_keys": ["replace-with-modelhub-api-key"],
    "model": "gemini-3-pro-image-preview",
    "width": 1024,
    "height": 1536,
    "imagex": {
      "access_key": "replace-with-imagex-ak",
      "secret_key": "replace-with-imagex-sk",
      "service_id": "replace-with-imagex-service-id"
    }
  },
  "prompt_tts": {
    "cpm": 280,
    "example_text": "这是一段用于试听音色效果的示例语音。",
    "speech_rate": 1.1,
    "storage": {
      "bucket": "replace-with-audio-bucket",
      "access_key": "replace-with-audio-access-key",
      "max_bytes": 33554432
    }
  },
  "seedance": {
    "base_url": "https://ark-cn-beijing.bytedance.net/api/v3/contents/generations/tasks",
    "api_key": "replace-with-seedance-api-key",
    "model": "replace-with-seedance-endpoint",
    "ratio": "9:16",
    "resolution": "720p",
    "duration": 5
  },
  "video_storage": {
    "space": "jichuang",
    "top_account_id": "replace-with-top-account-id",
    "max_bytes": 1073741824
  },
  "finalvideo": {
    "width": 720,
    "height": 1280,
    "biz_id": 1
  },
  "image_media_url": {
    "psm": "replace-with-image-psm",
    "domain": "replace-with-image-domain",
    "access_key": "replace-with-media-ak",
    "secret_key": "replace-with-media-sk",
    "template": "noop",
    "expire_seconds": 3600
  },
  "audio_media_url": {
    "psm": "replace-with-audio-psm",
    "domain": "replace-with-audio-domain",
    "access_key": "replace-with-media-ak",
    "secret_key": "replace-with-media-sk",
    "template": "noop",
    "expire_seconds": 3600
  },
  "video_media_url": {
    "psm": "replace-with-video-psm",
    "domain": "replace-with-video-domain",
    "access_key": "replace-with-media-ak",
    "secret_key": "replace-with-media-sk",
    "template": "noop",
    "expire_seconds": 3600
  }
}
